{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siliconcraft.dev/schema/pdk.yaml.schema",
  "title": "siliconcraft process fragment schema",
  "description": "Schema for the normalized process fragment shape. Profiles may keep layers, rules, devices, model, PEX, and UI data in separate source files; common/process_ir.py composes them into the ProcessIR consumed by generators. Generated collateral is never hand-edited.",
  "type": "object",
  "required": ["meta", "layers"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "process", "grid_um", "rule_family"],
      "properties": {
        "name": { "type": "string", "description": "profile directory name, e.g. ami06" },
        "process": { "type": "string", "description": "technology identifier, e.g. AMI_C5N" },
        "foundry": { "type": "string" },
        "description": { "type": "string" },
        "mosis_code": { "type": "string" },
        "cdk_techlib": { "type": "string" },
        "node_um": { "type": "number", "description": "nominal process node in microns" },
        "lambda_um": { "type": "number", "default": 0.5, "description": "SCMOS lambda in microns; defaults to 0.5 when omitted" },
        "grid_um": { "type": "number", "description": "design grid (gridRes) in microns" },
        "min_channel_um": { "type": "number" },
        "min_width_um": { "type": "number" },
        "well_type": { "enum": ["n", "p", "e"], "description": "n = n-well, p = p-well, e = epitaxial/twin-well" },
        "rule_family": {
          "enum": ["scmos", "scmos_subm", "scmos_deep", "native"],
          "description": "rule family independent of the process profile; scmos_deep is reserved for source-backed NCSU SCMOS DEEP variants; native is for non-SCMOS profiles"
        },
        "hvcmos_rule_source": { "type": "string", "description": "explicit provenance/limitation for profile-specific HV rules" },
        "mask_map_status": { "type": "string", "description": "foundry, provisional, or unavailable logical layer mapping" },
        "gds_output_policy": { "type": "string" },
        "stacked_vias": { "type": "boolean" },
        "features": {
          "type": "object",
          "description": "per-process feature flags (metal3Available, elecAvailable, ...)",
          "additionalProperties": { "type": "boolean" }
        },
        "physical_capabilities": {
          "type": "object",
          "description": "physical process capability declarations; separate from tool/collateral readiness",
          "properties": {
            "isolation": {
              "type": "object",
              "properties": {
                "state": { "enum": ["supported", "partial", "blocked", "unavailable"] },
                "authority": { "type": "string" },
                "topology": { "type": "string" },
                "modes": { "type": "array", "items": { "type": "string" } },
                "domains": { "type": "array", "items": { "type": "string" } },
                "legacy_well_type": { "enum": ["n", "p", "e"] },
                "deep_nwell": { "type": "boolean" },
                "twin_well": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "well_topology": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "authority": { "type": "string" },
                "legacy_well_type": { "enum": ["n", "p", "e"] }
              },
              "additionalProperties": true
            },
            "advanced_isolation": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "authority": { "type": "string" },
                "topology": { "type": "string" },
                "domains": { "type": "array", "items": { "type": "string" } },
                "deep_nwell": { "type": "boolean" },
                "twin_well": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "bipolar": { "$ref": "#/$defs/physical_capability" },
            "rf": { "$ref": "#/$defs/physical_capability" },
            "power": { "$ref": "#/$defs/physical_capability" },
            "esd": { "$ref": "#/$defs/physical_capability" },
            "opto": { "$ref": "#/$defs/physical_capability" },
            "mems": { "$ref": "#/$defs/physical_capability" },
            "special_devices": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "license": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "layers": {
      "type": "array",
      "description": "physical (drawing) layers; the layer map is the stable cross-tool contract",
      "items": {
        "type": "object",
        "required": ["name", "purpose", "gds", "role"],
        "properties": {
          "name": { "type": "string" },
          "purpose": { "enum": ["drawing", "pin", "net", "label", "boundary"] },
          "gds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["layer", "datatype"],
              "properties": {
                "layer": { "type": "integer" },
                "datatype": { "type": "integer" }
              }
            }
          },
          "cif": { "type": "array", "items": { "type": "string" } },
          "role": { "enum": ["well", "active", "select", "gate", "cut", "metal", "resistor", "capacitor", "pad", "implant", "marker", "isolation", "misc"] },
          "available": { "type": "boolean", "description": "present in this process variant" },
          "display": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "stipple": { "type": "string" },
              "line_style": { "type": "string" }
            }
          },
          "note": { "type": "string" }
        }
      }
    },
    "derived_layers": {
      "type": "object",
      "description": "backend-neutral derived-layer recognition expressions",
      "additionalProperties": { "$ref": "#/$defs/recognition_expr" }
    },
    "stackup": {
      "type": "object",
      "description": "PEX source data; generators emit Magic extract rules and KLayout PEX tables",
      "properties": {
        "metals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "thickness_um": { "type": "number" },
              "sheet_r_ohm_sq": { "type": "number" },
              "eps_rel": { "type": "number" },
              "role": { "enum": ["signal", "ground", "pad"] }
            }
          }
        },
        "dielectrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "eps_rel": { "type": "number" },
              "thickness_um": { "type": "number" }
            }
          }
        },
        "substrate": {
          "type": "object",
          "properties": {
            "type": { "enum": ["bulk", "soi"] },
            "rho_ohm_cm": { "type": "number" },
            "eps_rel": { "type": "number" }
          }
        }
      }
    },
    "stack_v2": {
      "type": "object",
      "description": "cross-section contract for physical, electrical, and extraction stack data",
      "required": ["version", "layers"],
      "properties": {
        "version": { "enum": [2] },
        "layers": {
          "type": "array",
          "description": "ordered physical cross-section from substrate to passivation",
          "items": { "$ref": "#/$defs/stack_layer" }
        },
        "semiconductors": {
          "type": "array",
          "items": { "$ref": "#/$defs/stack_semiconductor" }
        },
        "conductors": {
          "type": "array",
          "items": { "$ref": "#/$defs/stack_conductor" }
        },
        "dielectrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/stack_dielectric" }
        },
        "vias": {
          "type": "array",
          "items": { "$ref": "#/$defs/stack_via" }
        },
        "substrate": { "$ref": "#/$defs/stack_substrate" },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lower", "upper"],
            "properties": {
              "lower": { "type": "string" },
              "upper": { "type": "string" },
              "interface_type": { "type": "string" },
              "note": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "provenance": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "rules": {
      "type": "object",
      "description": "typed design-rule tables; DRC decks, PCells and the cell generator consume these",
      "properties": {
        "grid": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "width": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "spacing": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "enclosure": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "extension": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "area": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "notch": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "overlap": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "hvcmos": {
          "type": "object",
          "description": "explicit profile-specific marker, hierarchy, drift, and voltage-net rules",
          "properties": {
            "markers": { "type": "array", "items": { "$ref": "#/$defs/hv_contract" } },
            "hierarchy": { "type": "array", "items": { "$ref": "#/$defs/hv_contract" } },
            "drift": { "type": "array", "items": { "$ref": "#/$defs/hv_contract" } },
            "voltage_spacing": { "type": "array", "items": { "$ref": "#/$defs/voltage_rule" } },
            "voltage_classification": {
              "type": "object",
              "properties": {
                "mode": { "enum": ["strict", "exploratory"] },
                "marker_inference": { "type": "boolean" },
                "require_annotation": { "type": "boolean" },
                "unknown_rule_id": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "stdcell": {
          "type": "object",
          "description": "semantic fixed-height stdcell rules resolved by a profile adapter",
          "properties": {
            "adapter": { "type": "string" },
            "rule_map": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "group": { "type": "string" },
                  "id": { "type": "string" },
                  "layer": { "type": "string" },
                  "layer2": { "type": "string" },
                  "value_um": { "type": "number" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "device_inventory": {
      "type": "object",
      "description": "profile-provided grouped device inventory used by legacy LVS and extraction adapters",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/device_inventory_entry" }
      }
    },
    "device_bindings": {
      "type": "object",
      "description": "profile bindings from physical/inventory names to canonical families and tool backends",
      "additionalProperties": { "$ref": "#/$defs/device_binding" }
    },
    "canonical_catalog": {
      "$ref": "#/$defs/canonical_catalog",
      "description": "shared structural vocabulary; catalog membership is not process support"
    },
    "devices": {
      "description": "legacy compatibility role. New documents use device_inventory, device_bindings, and canonical_catalog.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/device_inventory_entry" }
          }
        },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/device_record" }
        }
      ]
    },
    "models": {
      "type": "object",
      "description": "simulation model files and corner sections",
      "properties": {
        "spice": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "corners": { "type": "array", "items": { "type": "string" } },
            "mismatch": { "type": "boolean" }
          }
        },
        "liberty": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "conditions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "cells": {
      "type": "object",
      "description": "standard-cell collateral (generated via LibreCell) and bootstrap libraries",
      "properties": {
        "digital": {
          "type": "object",
          "properties": {
            "cell_height_um": { "type": "number" },
            "rail_width_um": { "type": "number" },
            "catalog": { "type": "array", "items": { "type": "string" } },
            "bootstrap": {
              "type": "object",
              "description": "static library used as conformance oracle / initial bootstrap",
              "properties": {
                "name": { "type": "string" },
                "gds": { "type": "string" },
                "lef": { "type": "string" },
                "liberty": { "type": "string" },
                "license": { "type": "string" }
              }
            }
          }
        },
        "analog": {
          "type": "object",
          "properties": {
            "symbols": { "type": "array", "items": { "type": "string" } },
            "pcells": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "$defs": {
    "device_kind": {
      "enum": [
        "mos4", "mos", "soi_mos", "asymmetric_mos4", "rf_mos4",
        "resistor", "resistor2", "resistor3", "resistor4",
        "capacitor", "capacitor2", "capacitor3",
        "diode", "diode2", "diode3", "schottky", "schottky2",
        "bjt", "bjt3", "bjt4", "hbt", "hbt3", "hbt4",
        "varactor", "varactor2", "varactor3", "svaricap4",
        "tap", "tap2", "inductor", "inductor2", "inductor3", "inductor4",
        "esd", "esd2", "fuse", "fuse2"
      ]
    },
    "geometry_contract": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["fixed", "scalable", "enumerated", "derived"]
        },
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } },
        "legal_values": {
          "oneOf": [
            { "type": "array" },
            { "type": "object" }
          ]
        },
        "derive": { "type": "string" },
        "parameter_units": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      },
      "additionalProperties": true
    },
    "terminal_map": {
      "type": "object",
      "properties": {
        "map": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "canonical_to_backend": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "order": { "type": "array", "items": { "type": "string" } },
        "terminal_order": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "backend_terminal_map": {
      "oneOf": [
        { "$ref": "#/$defs/terminal_map" },
        {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      ]
    },
    "parameter_transform": {
      "type": "object",
      "required": ["operation"],
      "properties": {
        "operation": {
          "enum": ["rename", "scale", "multiply", "divide", "derive", "ignore"]
        },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "factor": { "type": "number" },
        "expression": { "type": "string" }
      },
      "additionalProperties": false
    },
    "device_record": {
      "type": "object",
      "required": ["name", "terminals"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/device_kind" },
        "terminals": { "type": "array", "items": { "type": "string" } },
        "terminal_order": { "type": "array", "items": { "type": "string" } },
        "canonical_family": { "type": "string" },
        "origin": { "enum": ["intentional", "parasitic"] },
        "geometry": { "$ref": "#/$defs/geometry_contract" },
        "extraction": {
          "type": "object",
          "properties": {
            "level": { "enum": ["none", "lumped", "distributed", "field_solver"] },
            "escalation": {
              "type": "array",
              "items": { "enum": ["geometry", "lumped", "distributed", "field_solver"] }
            },
            "provenance": { "type": "string" },
            "model": { "type": "string" }
          },
          "additionalProperties": true
        },
        "analysis": {
          "type": "object",
          "properties": {
            "representation": {
              "enum": ["compact", "lumped", "s_parameters", "vector_fit", "field_solver"]
            },
            "frequency_dependent": { "type": "boolean" },
            "requires_stack_v2": { "type": "boolean" },
            "source": { "type": "string" }
          },
          "additionalProperties": true
        },
        "attributes": { "type": "object", "additionalProperties": true },
        "recognition": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/recognition_expr" }
        },
        "model": { "type": "string" },
        "params": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "device_inventory_entry": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/device_kind" },
        "status": { "type": "string" },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    },
    "device_binding": {
      "type": "object",
      "properties": {
        "canonical_family": { "type": "string" },
        "canonical_variant": { "type": "string" },
        "canonical_attributes": {
          "type": "object",
          "description": "validated by the referenced family attribute declaration",
          "additionalProperties": true
        },
        "terminal_maps": {
          "type": "object",
          "properties": {
            "simulation": { "$ref": "#/$defs/terminal_map" },
            "lvs": { "$ref": "#/$defs/terminal_map" }
          },
          "additionalProperties": false
        },
        "layout": { "type": "object", "additionalProperties": true },
        "simulation": {
          "type": "object",
          "properties": {
            "representation": { "type": "string" },
            "name": { "type": "string" },
            "prefix": { "type": "string" },
            "model_library": { "type": "string" },
            "terminal_map": { "$ref": "#/$defs/backend_terminal_map" },
            "terminal_order": { "type": "array", "items": { "type": "string" } },
            "parameter_map": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "parameter_transforms": {
              "type": "array",
              "items": { "$ref": "#/$defs/parameter_transform" }
            }
          },
          "additionalProperties": true
        },
        "lvs": {
          "type": "object",
          "properties": {
            "terminal_map": { "$ref": "#/$defs/backend_terminal_map" },
            "terminal_order": { "type": "array", "items": { "type": "string" } },
            "parameter_transforms": {
              "type": "array",
              "items": { "$ref": "#/$defs/parameter_transform" }
            },
            "netgen_class": { "type": "string" },
            "permutable": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "string" } }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "canonical_family": {
      "type": "object",
      "required": ["device", "variants"],
      "properties": {
        "device": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "kind": { "$ref": "#/$defs/device_kind" },
            "terminals": { "type": "array", "items": { "type": "string" } },
            "terminal_order": { "type": "array", "items": { "type": "string" } },
            "geometry": { "$ref": "#/$defs/geometry_contract" },
            "attributes": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": true
        },
        "variants": {
          "type": "object",
          "additionalProperties": { "type": "object", "additionalProperties": true }
        }
      },
      "additionalProperties": true
    },
    "canonical_catalog": {
      "type": "object",
      "required": ["families"],
      "properties": {
        "schema_version": { "type": "integer" },
        "default_family": { "type": "string" },
        "families": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/canonical_family" }
        }
      },
      "additionalProperties": true
    },
    "physical_capability": {
      "anyOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "properties": {
            "state": { "enum": ["supported", "partial", "blocked", "unavailable"] },
            "authority": { "type": "string" },
            "modes": { "type": "array", "items": { "type": "string" } },
            "devices": { "type": "array", "items": { "type": "string" } },
            "extraction_levels": {
              "type": "array",
              "items": { "enum": ["none", "lumped", "distributed", "field_solver"] }
            },
            "source": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "stack_layer": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string" },
        "kind": {
          "enum": ["semiconductor", "conductor", "dielectric", "via", "substrate", "passivation", "other"]
        },
        "material": { "type": "string" },
        "thickness_um": { "type": "number", "minimum": 0 },
        "z_bottom_um": { "type": "number" },
        "z_top_um": { "type": "number" },
        "electrical_role": { "type": "string" },
        "provenance": { "type": "string" }
      },
      "additionalProperties": true
    },
    "stack_semiconductor": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "material": { "type": "string" },
        "thickness_um": { "type": "number", "minimum": 0 },
        "doping": { "type": "string" },
        "resistivity_ohm_cm": { "type": "number", "exclusiveMinimum": 0 },
        "eps_rel": { "type": "number", "exclusiveMinimum": 0 },
        "mobility_cm2_v_s": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "stack_conductor": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "material": { "type": "string" },
        "thickness_um": { "type": "number", "minimum": 0 },
        "sheet_r_ohm_sq": { "type": "number", "minimum": 0 },
        "resistivity_ohm_cm": { "type": "number", "exclusiveMinimum": 0 },
        "role": { "type": "string" }
      },
      "additionalProperties": true
    },
    "stack_dielectric": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "material": { "type": "string" },
        "thickness_um": { "type": "number", "minimum": 0 },
        "eps_rel": { "type": "number", "exclusiveMinimum": 0 },
        "loss_tangent": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "stack_via": {
      "type": "object",
      "required": ["name", "from", "to"],
      "properties": {
        "name": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "material": { "type": "string" },
        "resistance_ohm": { "type": "number", "minimum": 0 },
        "contact_area_um2": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "stack_substrate": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["bulk", "soi", "sige", "compound", "other"] },
        "material": { "type": "string" },
        "doping": { "type": "string" },
        "rho_ohm_cm": { "type": "number", "exclusiveMinimum": 0 },
        "eps_rel": { "type": "number", "exclusiveMinimum": 0 },
        "box_thickness_um": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "recognition_expr": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "layer": { "type": "string" },
            "and": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/recognition_expr" }
            },
            "or": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/recognition_expr" }
            },
            "not": { "$ref": "#/$defs/recognition_expr" },
            "holes": { "$ref": "#/$defs/recognition_expr" },
            "interact": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/recognition_expr" }
            },
            "enclose": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/recognition_expr" }
            },
            "inside": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/recognition_expr" }
            },
            "touch": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/recognition_expr" }
            },
            "overlap": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/recognition_expr" }
            },
            "connected_to": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/recognition_expr" }
            },
            "grow": { "$ref": "#/$defs/recognition_distance" },
            "shrink": { "$ref": "#/$defs/recognition_distance" }
          },
          "additionalProperties": false
        }
      ]
    },
    "recognition_distance": {
      "type": "object",
      "required": ["expr", "distance_um"],
      "properties": {
        "expr": { "$ref": "#/$defs/recognition_expr" },
        "distance_um": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "layer", "value_um"],
      "properties": {
        "id": { "type": "string", "description": "rule reference, e.g. SCMOS 1.1" },
        "layer": { "type": "string" },
        "layer2": { "type": "string", "description": "second layer for spacing/enclosure/extension" },
        "family": { "type": "string" },
        "override_of": { "type": "string" },
        "value_um": { "type": "number", "description": "limit in microns" },
        "compare": { "enum": ["min", "max", "exact"] },
        "nets": { "enum": ["any", "same", "diff"], "description": "sameNet/diffNet connectivity qualifier" },
        "app": { "type": "boolean", "description": "apposition filter (Diva app > 0); approximated by opposite-edge space_check" },
        "condition": { "type": "string", "description": "process feature condition, e.g. submicron" },
        "authority": {
          "enum": ["public_native", "scmos_compat", "provisional_hv_policy", "foundry_private"],
          "description": "rule authority layer used to select public and compatibility decks"
        },
        "source": { "type": "string", "description": "provenance: divaDRC.rul rule id, MOSIS doc, ..." },
        "note": { "type": "string" },
        "net_property": { "type": "string" }
      }
    },
    "hv_contract": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "marker": { "type": "string" },
        "target": { "type": "string" },
        "outer": { "type": "string" },
        "inner": { "type": "string" },
        "relation": { "type": "string" },
        "parent": { "type": "string" },
        "forbid_overlap": { "type": "string" },
        "authority": {
          "enum": ["public_native", "scmos_compat", "provisional_hv_policy", "foundry_private"]
        },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "voltage_rule": {
      "type": "object",
      "required": ["id", "layer", "class1", "value_um"],
      "properties": {
        "id": { "type": "string" },
        "layer": { "type": "string" },
        "layer2": { "type": "string" },
        "class1": { "type": "string", "minLength": 1, "description": "profile-defined voltage class identifier" },
        "class2": { "type": "string", "minLength": 1, "description": "profile-defined voltage class identifier" },
        "potential": { "enum": ["any", "same", "different"] },
        "value_um": { "type": "number" },
        "authority": {
          "enum": ["public_native", "scmos_compat", "provisional_hv_policy", "foundry_private"]
        },
        "source": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
