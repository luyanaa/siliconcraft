* profiles/tr1um/models/tr1um.lib
* Source-preserving assembly of OpenSUSI/TR-1um IP62 public model files.
* Source commit: d83eb77fcbe8c587809dd9f4532f9464c5501ab2; license: Apache-2.0.
* Engineering-only nominal cards. No foundry qualification or full corners.
.lib tr1um
* Default zero-bias trim parameters required by the upstream BSIM expressions.
* Callers may override these process knobs after including this section.
.param vthMP=0 vthMN=0 vthMPE=0 vthMNE=0

* BEGIN SOURCE models_IP62_mos_os00_calibrated.lib
* TR-1um OS00 engineering MOS overlay.
* Electrical parameters are unchanged from models_IP62_mos_v2.lib.
* This copy only closes the PMOS/PMOSg ngspice terminator typo; original source remains immutable.
* No MOS systematic calibration is claimed: use sign-off margins and manual limits.

* /// IP62 Model File ///
* /// models_IP62_mos_v2  ///
* /// 2025.08.19 ARAKAWA Natsuki ///

* simulator lang=spectre

.param sdwidth=2.8u

* // model PMOS ////////////////////////////////////////
.subckt PMOS d g s b
.param w=w l=l AS='w*sdwidth' AD='w*sdwidth' PS='2*(sdwidth+w)' PD='2*(sdwidth+w)' nrd=0 nrs=0 m=1
M1 d g s b PMOS_mst w=w l=l as=as ad=ad ps=ps pd=pd nrd=nrd nrs=nrs m=m
.ends PMOS

.model PMOS_mst PMOS
* type	 = p	       							      
+ vth0     = '-0.678475+vthMP'
+ level = 49 version = 3.3 tnom = 27
+ tox      = 1.95e-08       xj       = 3.2e-07        nch      = 1.6e+17
+ k1       = 0.865126       k2       = 0
+ k3       = 19.9415        k3b      = -10            w0       = 3.12082e-06
+ nlx      = 3.11982e-07    dvt0w    = 0              dvt1w    = 0
+ dvt2w    = -0.032         dvt0     = 1.41234        dvt1     = 0.524423
+ dvt2     = -0.031468      vbm      = -3             u0       = 0.0196669
+ ua       = 1.77818e-09    ub       = 2.67881e-18    uc       = -8.71484e-11
+ vsat     = 700000         a0       = 1.24985        ags      = 0.131047
+ b0       = 8.23429e-09    b1       = -1e-07         keta     = 0.0135411
+ a1       = 0              a2       = 1              rdsw     = 1989.6
+ prwg     = -0.001         prwb     = 0.0554082      wr       = 1
+ wint     = 8.28413e-07    lint     = -8.68261e-08   xl       = 0
+ xw       = 0              dwg      = -2.60218e-08   dwb      = -4.2585e-08
+ voff     = -0.15          nfactor  = 2              cit      = 0
+ cdsc     = 0.01           cdscd    = 0              cdscb    = 0
+ eta0     = 0.159519       etab     = -0.07722       dsub     = 0.567003
+ pclm     = 9.90814        pdiblc1  = 1              pdiblc2  = 0.00997756
+ pdiblcb  = -0.000118146   drout    = 0.823024       pscbe1   = 5.67248e+09
+ pscbe2   = 9.89777e-09    pvag     = 4.17315        delta    = 0.03
+ rsh      = 44.9607        mobmod   = 1              prt      = 292.21
+ ute      = -1.00674       kt1      = -0.506653      kt1l     = -1e-07
+ kt2      = -0.0438588     ua1      = 3.51352e-09    ub1      = -9.77898e-18
+ uc1      = -9.8421e-11    at       = 100000         nqsmod   = 0
+ wl       = 0              wln      = 1              ww       = 0
+ wwn      = 1              wwl      = 0              ll       = 0
+ lln      = 1              lw       = 0              lwn      = 1
+ lwl      = 0              capmod   = 2              noff     = 1
+ acde     = 1              moin     = 15             tpbswg   = 0
+ tcjswg   = 0              cgsl     =1.81e-09        cgdl     =1.81e-09
+ cj       =1.02e-03



*// model NMOS ////////////////////////////////////////
.subckt NMOS d g s b
.param w=w l=l AS='w*sdwidth' AD='w*sdwidth' PS='2*(sdwidth+w)' PD='2*(sdwidth+w)' nrd=0 nrs=0 m=1
M1 d g s b NMOS_mst w=w l=l as=as ad=ad ps=ps pd=pd nrd=nrd nrs=nrs m=m
.ends NMOS

.model NMOS_mst NMOS
* type	 = n	       							      
+ vth0     = '0.762948+vthMN'
+ level    = 49             version  = 3.3            tnom     = 27
+ tox      = 1.95e-08       xj       = 3.4e-07        nch      = 3.2e+16
+ k1       = 0.854475       k2       = -0.0311518
+ k3       = 86.2769        k3b      = 10             w0       = 5e-05
+ nlx      = 1.38901e-07    dvt0w    = 0              dvt1w    = 0
