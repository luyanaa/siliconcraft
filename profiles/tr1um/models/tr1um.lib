+ pdiblcb  = 1e-10          drout    = 0.850868       pscbe1   = 4.96301e+08
+ pscbe2   = 0.001          pvag     = 2.71787        delta    = 0.0147876
+ mobmod   = 1              prt      = -774           ute      = -1.70065
+ kt1      = -0.464518      kt1l     = -1e-07         kt2      = -0.0556928
+ ua1      = 2.9856e-09     ub1      = -9.01491e-18   uc1      = -1e-10
+ at       = 80156.4        nqsmod   = 0              wl       = 0
+ wln      = 1              ww       = 0              wwn      = 1
+ wwl      = 0              ll       = 0              lln      = 1
+ lw       = 0              lwn      = 1              lwl      = 0
+ capmod   = 2              tcj      = 0              tpb      = 0
+ tcjsw    = 0              tpbsw    = 0              noff     = 1
+ acde     = 1              moin     = 15             tpbswg   = 0
+ tcjswg   = 0              cgsl     =2.02e-09        cgdl     =2.02e-09
+ cj       =7.44e-04




// model MPE ////////////////////////////////////////
.subckt MPE d g s b
.param w=0 l=0 as=0 ad=0 ps=0 pd=0 nrd=0 nrs=0 m=1
M1 d g s b MPE_mst w=w l=l as=as ad=ad ps=ps pd=pd nrd=nrd nrs=nrs m=m
.ends MPE
  
